# Frontend Environment Variables
# Copy this to .env.local and update with your values

# API endpoint for the backend server
# For local development (separate Vite + Express servers):
VITE_API_URL=http://localhost:3001

# For production web (Vercel frontend + Railway/Render backend) this is not
# needed — the frontend is served by the same Express server, so API calls
# use relative URLs automatically.

# For iOS/Capacitor builds, set this to your deployed backend URL so the
# native WebView can reach the API:
# VITE_API_URL=https://your-backend.railway.app
