# Frontend Environment Variables
# Copy this to .env.local and fill in your values.

# ── Backend API ───────────────────────────────────────────────────────────
# For local development (Vite dev server + Express on separate ports):
VITE_API_URL=http://localhost:3001
# In production the frontend is served by the same Express process,
# so relative URLs work and this variable is not needed.
# For iOS/Capacitor builds point this at your deployed backend:
# VITE_API_URL=https://your-backend.railway.app

# ── Supabase (persistent storage) ────────────────────────────────────────
# Create a free project at https://supabase.com, then run
# supabase/migrations/001_initial.sql in the SQL Editor.
# Get these values from Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Without these set the app falls back to localStorage (development / demo use).
